{
  "name": "@itslil/lil2-micromark",
  "version": "0.1.0",
  "description": "micromark, rewritten in typed LilScript: flat data, same HTML",
  "type": "module",
  "license": "MIT",
  "author": "yeargun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/lil2-micromark.git"
  },
  "bugs": {
    "url": "https://github.com/yeargun/lil2-micromark/issues"
  },
  "homepage": "https://yeargun.github.io/lil2-micromark/",
  "keywords": [
    "micromark",
    "commonmark",
    "markdown",
    "html",
    "lilscript",
    "lil2",
    "typed",
    "fast"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/micromark.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "convex": "./dist/micromark.js",
      "deno": "./dist/micromark.js",
      "edge-light": "./dist/micromark.js",
      "react-native": "./dist/micromark.js",
      "worker": "./dist/micromark.js",
      "workerd": "./dist/micromark.js",
      "browser": "./dist/browser/micromark.js",
      "default": "./dist/micromark.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "types",
    "NOTICE.md"
  ],
  "scripts": {
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "node --test test/differential.test.mjs test/events.test.mjs test/browser.test.mjs"
  },
  "devDependencies": {
    "character-entities": "2.0.2",
    "commonmark.json": "^0.31.0",
    "micromark": "4.0.2",
    "playwright-core": "^1.62.0"
  }
}
